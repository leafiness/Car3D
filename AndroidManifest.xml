<?xml version="1.0" encoding="utf-8"?>
<!-- 3D 车况（原生版）：车机 Android 10，宿主（com.wzw.bydmodule）的多窗口 / 悬浮窗口把应用嵌进窗口里显示，所以要能随窗口改大小、不重建 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ljone.car3d"
    android:versionCode="517"
    android:versionName="0.5.17-exp">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="29" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- 封面是宿主给的 http 局域网地址：要联网权限，且允许明文 http（Android 9+ 默认拦截） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 高德导航 SDK 红绿灯（实验分支）所需；ENABLED=false 时不会真正用到 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <package android:name="com.wzw.bydmodule" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 全屏页：从多窗口里点全屏键时在主屏上单独开一个任务；状态栏按设置收起，所以不用全屏主题 -->
        <activity
            android:name=".FullActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.ljone.car3d.full"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode" />
    </application>
</manifest>

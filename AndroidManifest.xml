<?xml version="1.0" encoding="utf-8"?>
<!-- 3D 车况（原生版）：车机 Android 10，宿主（com.wzw.bydmodule）的多窗口 / 悬浮窗口把应用嵌进窗口里显示，所以要能随窗口改大小、不重建 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ljone.car3d"
    android:versionCode="676"
    android:versionName="0.8.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="29" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- 封面是宿主给的 http 局域网地址：要联网权限，且允许明文 http（Android 9+ 默认拦截） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内安装更新包（Android 8+ 需要；车机会弹「未知来源」授权） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 蓝牙音乐的封面：手机传过来、车机存在 /storage 下的图，要读存储（第一次用到时问车主一次；同琉光） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <queries>
        <package android:name="com.wzw.bydmodule" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <!-- 通道标记：正式包 official；测试包由发版脚本在构建期改成 test。
             设置页按它标注（测试版），看实际装的版本，与「测试版更新」开关无关 -->
        <meta-data android:name="car3d.channel" android:value="official" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 全屏页：从多窗口里点全屏键时在主屏上单独开一个任务；状态栏按设置收起，所以不用全屏主题 -->
        <activity
            android:name=".FullActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.ljone.car3d.full"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode" />
        <!-- 自写文件提供者：把缓存里的更新包暴露给系统安装器（无 AndroidX 依赖） -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="com.ljone.car3d.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- 安装完成回调：成功则删缓存安装包 -->
        <receiver android:name=".InstallDoneReceiver" android:exported="false" />
    </application>
</manifest>
